rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function validVideo(d) {
      return d.keys().hasOnly(['title','description','thumbnailUrl','originalUrl','shortUrl','category','status','clicks','createdAt','updatedAt','publishedAt','createdBy'])
        && d.title is string && d.title.size() > 0 && d.title.size() <= 200
        && d.originalUrl is string && d.originalUrl.matches('https?://.*') && d.originalUrl.size() <= 2000
        && d.status in ['draft', 'published', 'archived']
        && (!('shortUrl' in d) || (d.shortUrl is string && d.shortUrl.size() <= 2000))
        && (!('thumbnailUrl' in d) || (d.thumbnailUrl is string && d.thumbnailUrl.size() <= 150000
              && (d.thumbnailUrl == '' || d.thumbnailUrl.matches('(https?://|data:image/(webp|jpeg|png);base64,).*'))))
        && (!('category' in d) || (d.category is string && d.category.size() <= 40))
        && (!('description' in d) || (d.description is string && d.description.size() <= 500))
        && (!('clicks' in d) || d.clicks is int);
    }

    // Pengunjung hanya boleh menambah penghitung klik tepat +1 pada video published
    function onlyClickPlusOne() {
      return resource.data.status == 'published'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['clicks'])
        && request.resource.data.clicks == resource.data.get('clicks', 0) + 1;
    }

    match /videos/{id} {
      allow read: if resource.data.status == 'published' || isAdmin();
      allow create: if isAdmin() && validVideo(request.resource.data);
      allow update: if (isAdmin() && validVideo(request.resource.data)) || onlyClickPlusOne();
      allow delete: if isAdmin();
    }

    // Catatan klik: publik hanya boleh membuat, admin yang membaca/menghapus
    match /clicks/{id} {
      allow create: if request.resource.data.keys().hasOnly(['videoId','country','createdAt'])
        && request.resource.data.videoId is string && request.resource.data.videoId.size() <= 40
        && request.resource.data.country is string && request.resource.data.country.size() == 2
        && request.resource.data.createdAt == request.time;
      allow read, delete: if isAdmin();
      allow update: if false;
    }

    match /settings/{id} {
      allow read, write: if false;
    }

    match /admins/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }
  }
}
